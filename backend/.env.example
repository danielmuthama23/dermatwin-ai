# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git — add it to .gitignore.

# YouCam / Perfect Corp API credentials
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Must be a public image URL or signed upload endpoint, not the API playground.
YOUCAM_SOURCE_FILE_URL=
YOUCAM_TIMEOUT_SECONDS=180000
YOUCAM_POLL_SECONDS=200000

# Hedera (Hiero) — tamper-evident audit trail via Consensus Service
# Get a free testnet account at https://portal.hedera.com
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=
HEDERA_NETWORK=testnet

# Optional LLM providers used by the reasoning agents
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# App config
APP_ENV=development
